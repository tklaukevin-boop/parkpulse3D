<footer>
  <div class="wrap">
    <span>ParkPulse HK · 泊快充 3D · mobile how-to</span>
    <span class="tc">教學頁 · 唔會修改應用原始碼 · 截圖來自 parkpulsehk.web.app</span>
    <span class="sc">教学页 · 不会修改应用源代码 · 截图来自 parkpulsehk.web.app</span>
  </div>
</footer>

<script>
(function(){
  var root = document.documentElement;
  var btnTc = document.getElementById('btn-tc');
  var btnSc = document.getElementById('btn-sc');
  function apply(lang){
    if(lang === 'sc'){
      root.classList.add('lang-sc');
      btnTc.setAttribute('aria-pressed','false');
      btnSc.setAttribute('aria-pressed','true');
    } else {
      root.classList.remove('lang-sc');
      btnTc.setAttribute('aria-pressed','true');
      btnSc.setAttribute('aria-pressed','false');
      lang = 'tc';
    }
    try { localStorage.setItem('parkpulse-howto-lang', lang); } catch(e){}
  }
  btnTc.addEventListener('click', function(){ apply('tc'); });
  btnSc.addEventListener('click', function(){ apply('sc'); });
  var saved = null;
  try { saved = localStorage.getItem('parkpulse-howto-lang'); } catch(e){}
  apply(saved === 'sc' ? 'sc' : 'tc');
})();
</script>
</body>
</html>
