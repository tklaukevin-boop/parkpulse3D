# GEMINI_API_KEY: Required for Gemini AI API calls (injected via secret store)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Server-side environment variable injected into GCP container / Cloud Run.
# Kept securely on backend (server.ts) to call Google Routes API without exposing to client.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
